{
    "swagger": "2.0",
    "info": {
        "description": "MCP server providing Agent access to virtual stock depot.",
        "title": "ADJUDEX MCP Server REST API",
        "contact": {
            "url": "https://github.com/tdrn-org/adjudex-mcp"
        },
        "license": {
            "name": "Apache 2.0",
            "url": "http://www.apache.org/licenses/LICENSE-2.0.html"
        },
        "version": "1.0"
    },
    "host": "localhost:9123",
    "basePath": "/api/v1",
    "paths": {
        "/api/v1/info": {
            "get": {
                "description": "Get server software version details.",
                "produces": [
                    "application/json"
                ],
                "summary": "Query server info",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/rest.serverInfo"
                        }
                    },
                    "500": {
                        "description": "server error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/api/v1/ping": {
            "get": {
                "description": "Ping the server to check general health",
                "produces": [
                    "text/plain"
                ],
                "summary": "Ping the server",
                "responses": {
                    "200": {
                        "description": "ok",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "server error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/api/v1/portfolios": {
            "get": {
                "description": "Returns all portfolios without positions for performance.",
                "produces": [
                    "application/json"
                ],
                "summary": "List all portfolios",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/domain.Portfolio"
                            }
                        }
                    },
                    "500": {
                        "description": "server error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            },
            "post": {
                "description": "Creates a portfolio and returns it with its ID.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "summary": "Create a new portfolio",
                "parameters": [
                    {
                        "description": "Portfolio data",
                        "name": "portfolio",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/rest.portfolioCreateRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/domain.Portfolio"
                        }
                    },
                    "400": {
                        "description": "bad request",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/api/v1/portfolios/{id}": {
            "get": {
                "description": "Returns a single portfolio with all positions.",
                "produces": [
                    "application/json"
                ],
                "summary": "Get portfolio by ID",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Portfolio ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/domain.Portfolio"
                        }
                    },
                    "404": {
                        "description": "not found",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            },
            "delete": {
                "description": "Deletes a portfolio and all its positions.",
                "summary": "Delete a portfolio",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Portfolio ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "404": {
                        "description": "not found",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/api/v1/portfolios/{id}/holdings": {
            "get": {
                "description": "Returns the portfolio with all positions enriched with current market data.",
                "produces": [
                    "application/json"
                ],
                "summary": "Get portfolio holdings with live PnL",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Portfolio ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/domain.Holding"
                            }
                        }
                    },
                    "404": {
                        "description": "not found",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/api/v1/portfolios/{id}/positions": {
            "post": {
                "description": "Adds a new position and returns it with its ID.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "summary": "Add a position to a portfolio",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Portfolio ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Position data",
                        "name": "position",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/rest.positionAddRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/domain.Position"
                        }
                    },
                    "400": {
                        "description": "bad request",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/api/v1/portfolios/{id}/positions/{posId}": {
            "put": {
                "description": "Updates an existing position. Only provided fields are changed (PATCH semantics).",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "summary": "Update a position",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Portfolio ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Position ID",
                        "name": "posId",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Position updates",
                        "name": "position",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/rest.positionUpdateRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/domain.Position"
                        }
                    },
                    "400": {
                        "description": "bad request",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            },
            "delete": {
                "description": "Removes a position from a portfolio.",
                "summary": "Remove a position",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Portfolio ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Position ID",
                        "name": "posId",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "404": {
                        "description": "not found",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/api/v1/quotes/{listing}": {
            "get": {
                "description": "Returns the latest quote for a symbol (cached or live).",
                "produces": [
                    "application/json"
                ],
                "summary": "Get latest quote",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Listing",
                        "name": "listing",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/domain.Quote"
                        }
                    },
                    "404": {
                        "description": "not found",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/api/v1/quotes/{listing}/history": {
            "get": {
                "description": "Returns historical quotes for a symbol within a date range.",
                "produces": [
                    "application/json"
                ],
                "summary": "Get quote history",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Listing",
                        "name": "listing",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Start date (RFC3339)",
                        "name": "from",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "End date (RFC3339)",
                        "name": "to",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/domain.PriceHistory"
                        }
                    },
                    "404": {
                        "description": "not found",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/api/v1/rates": {
            "get": {
                "description": "Returns the exchange rates converting the given base currencies into the target currency. Quotes are always delivered in the currency their provider reports; clients use these rates to present them in their own currency.",
                "produces": [
                    "application/json"
                ],
                "summary": "Exchange rates",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Target currency (e.g. EUR). Defaults to the configured display currency.",
                        "name": "target",
                        "in": "query"
                    },
                    {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "collectionFormat": "csv",
                        "description": "Base currencies to convert from (repeatable, e.g. ?base=USD\u0026base=CHF).",
                        "name": "base",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/finance.ExchangeRate"
                            }
                        }
                    },
                    "503": {
                        "description": "rate not available",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "domain.Amount": {
            "type": "object",
            "properties": {
                "currency": {
                    "description": "Currency is the currency this value is denominated in.",
                    "allOf": [
                        {
                            "$ref": "#/definitions/finance.Currency"
                        }
                    ]
                },
                "value": {
                    "description": "Value is the monetary value in Currency.",
                    "type": "number"
                }
            }
        },
        "domain.Holding": {
            "type": "object",
            "properties": {
                "created_at": {
                    "type": "string"
                },
                "currency": {
                    "$ref": "#/definitions/finance.Currency"
                },
                "current_price": {
                    "description": "CurrentPrice is the price the market value is based on, including its\ncurrency and provenance.",
                    "allOf": [
                        {
                            "$ref": "#/definitions/finance.ListingPrice"
                        }
                    ]
                },
                "entry_date": {
                    "type": "string"
                },
                "entry_price": {
                    "type": "number"
                },
                "entry_value": {
                    "description": "EntryValue is quantity x entry price, denominated in the position currency.",
                    "allOf": [
                        {
                            "$ref": "#/definitions/domain.Amount"
                        }
                    ]
                },
                "id": {
                    "type": "string"
                },
                "listing": {
                    "$ref": "#/definitions/finance.Listing"
                },
                "market_value": {
                    "description": "MarketValue is quantity x current price, denominated in the price currency.",
                    "allOf": [
                        {
                            "$ref": "#/definitions/domain.Amount"
                        }
                    ]
                },
                "notes": {
                    "type": "string"
                },
                "pnl": {
                    "description": "PnL is only set when EntryValue and MarketValue share a currency.",
                    "allOf": [
                        {
                            "$ref": "#/definitions/domain.Amount"
                        }
                    ]
                },
                "pnl_percent": {
                    "description": "PnLPercent is only set when PnL is set.",
                    "type": "number"
                },
                "quantity": {
                    "type": "number"
                },
                "updated_at": {
                    "type": "string"
                }
            }
        },
        "domain.Portfolio": {
            "type": "object",
            "properties": {
                "created_at": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "positions": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/domain.Position"
                    }
                },
                "updated_at": {
                    "type": "string"
                }
            }
        },
        "domain.Position": {
            "type": "object",
            "properties": {
                "created_at": {
                    "type": "string"
                },
                "currency": {
                    "$ref": "#/definitions/finance.Currency"
                },
                "entry_date": {
                    "type": "string"
                },
                "entry_price": {
                    "type": "number"
                },
                "id": {
                    "type": "string"
                },
                "listing": {
                    "$ref": "#/definitions/finance.Listing"
                },
                "notes": {
                    "type": "string"
                },
                "quantity": {
                    "type": "number"
                },
                "updated_at": {
                    "type": "string"
                }
            }
        },
        "domain.PriceHistory": {
            "type": "object",
            "properties": {
                "listing": {
                    "$ref": "#/definitions/finance.Listing"
                },
                "quotes": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/domain.Quote"
                    }
                }
            }
        },
        "domain.Quote": {
            "type": "object",
            "properties": {
                "close": {
                    "description": "Close gives the close price of the day before the trading day identified by Timestamp.",
                    "type": "number"
                },
                "currency": {
                    "description": "Currency gives the currency for the given values.",
                    "allOf": [
                        {
                            "$ref": "#/definitions/finance.Currency"
                        }
                    ]
                },
                "high": {
                    "description": "High gives the high price at the trading day identified by Timestamp.",
                    "type": "number"
                },
                "listing": {
                    "description": "Instrument the financial instrument this price is for.",
                    "allOf": [
                        {
                            "$ref": "#/definitions/finance.Listing"
                        }
                    ]
                },
                "low": {
                    "description": "Low gives the low price at the trading day identified by Timestamp.",
                    "type": "number"
                },
                "open": {
                    "description": "Open gives the open price at the trading day identified by Timestamp.",
                    "type": "number"
                },
                "price": {
                    "description": "Price gives the current price at the trading day identified by Timestamp.",
                    "type": "number"
                },
                "source": {
                    "description": "Sources defines the provider this price has been\nqueried from.",
                    "type": "string"
                },
                "source_timestamp": {
                    "description": "SourceTimestamp defines the time this price has\nbeen queried.",
                    "type": "string"
                },
                "timestamp": {
                    "description": "Timestamp gives the point in time this price was current\naccording to the sourcing provider.",
                    "type": "string"
                },
                "volume": {
                    "description": "Volume gives the order volume at the trading day identified by Timestamp.",
                    "type": "integer"
                }
            }
        },
