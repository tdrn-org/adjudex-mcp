{
    "swagger": "2.0",
    "info": {
        "description": "MCP server providing Agent access to PIM services.",
        "title": "ADJUDEX MCP Server REST API",
        "contact": {
            "url": "https://github.com/tdrn-org/adjudex-mcp"
        },
        "license": {
